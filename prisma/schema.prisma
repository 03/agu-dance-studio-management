// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Mirrors StyleKey in lib/mock-data.ts
enum DanceStyle {
  JAZZ
  HIPHOP
  BALLET
  KPOP
  CONTEMPORARY
  LATIN
  JAZZ_KPOP
}

// Mirrors CardType in lib/mock-data.ts
enum CardType {
  TIMES
  PERIOD
  TRIAL
}

enum PaymentMethod {
  TRANSFER
  CASH
}

// Mirrors ClassSession.status in lib/mock-data.ts
enum SessionStatus {
  NORMAL
  CANCELED
}

// Mirrors ClassSession.myState / roster in lib/mock-data.ts
enum BookingState {
  BOOKED
  WAITLIST
  CANCELED
}

// What a BookingEvent recorded — a student (or admin, on their behalf)
// either joining an occurrence's roster or leaving it.
enum BookingEventType {
  ADD
  CANCEL
}

// Mirrors LedgerEntry.kind in lib/mock-data.ts
enum LedgerKind {
  CONSUME
  RECHARGE
  GIFT
  REFUND
  ADJUST
}

// Mirrors Student.status in lib/mock-data.ts
enum StudentStatus {
  ACTIVE
  EXPIRING
  INACTIVE
}

enum UserRole {
  STUDENT
  TEACHER
  ADMIN
}

model Teacher {
  id       String         @id @default(cuid())
  name     String
  nameEn   String
  avatar   String
  styles   DanceStyle[]
  sessions ClassSession[]
  user     User?

  @@map("teachers")
}

model Room {
  id         String         @id @default(cuid())
  code       String?
  name       String
  nameEn     String
  address    String?
  postalCode String?
  notes      String?
  sessions   ClassSession[]

  @@map("rooms")
}

model ClassSession {
  id            String         @id @default(cuid())
  style         DanceStyle
  teacher       Teacher        @relation(fields: [teacherId], references: [id])
  teacherId     String
  room          Room           @relation(fields: [roomId], references: [id])
  roomId        String
  day           Int // 0 = Mon ... 6 = Sun
  start         String // display time, e.g. "19:00"
  end           String
  capacity      Int
  levelZh       String
  levelEn       String
  status        SessionStatus  @default(NORMAL)
  // Bounds this session's own lifetime — both null (the default) means it
  // recurs indefinitely, same as before these fields existed. Set both for
  // a class that only ever exists within a window (a holiday-only intensive,
  // or a short-lived trial series). Distinct from ClassClosure, which pauses
  // an otherwise still-ongoing session rather than ending it.
  startDate     DateTime?
  endDate       DateTime?
  bookings      Booking[]
  closures      ClassClosure[]
  bookingEvents BookingEvent[]

  @@map("class_sessions")
}

// A date range during which a class doesn't run — a temporary pause, not
// the end of the series (see ClassSession.startDate/endDate for that).
// `sessionId` null means the closure applies to every session (e.g. a
// shared school-holiday break); set means it's specific to one session
// (e.g. a single teacher's short leave).
model ClassClosure {
  id        String        @id @default(cuid())
  startDate DateTime
  endDate   DateTime
  note      String?
  session   ClassSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String?

  @@map("class_closures")
}

model Student {
  id            String         @id @default(cuid())
  name          String
  phone         String?
  wechat        String?
  email         String?
  code          String? // admin-facing student/member code, distinct from the internal id
  joined        String // display label, e.g. "2024-06"
  status        StudentStatus  @default(ACTIVE)
  // Opaque bearer credential encoded into the student's check-in QR code
  // (see lib/checkin.ts) — DB-generated so every existing row gets one for
  // free at migration time, same idea as Session.token but a stable,
  // regenerable value rather than an expiring login session.
  checkInCode   String         @unique @default(dbgenerated("gen_random_uuid()"))
  // Free-text note the student writes about themself, e.g. injuries or
  // things a teacher should know — visible to the student, their teachers,
  // and admin, but never in a bulk list another student could see (see
  // mapStudent's includeNote option).
  note          String?
  cards         StudentCard[]
  ledgerEntries LedgerEntry[]
  bookings      Booking[]
  bookingEvents BookingEvent[]
  payments      Payment[]
  user          User?

  @@map("students")
}

// A booking is one student's relationship to one specific calendar
// occurrence of a session — ClassSession is a recurring weekly template
// (Monday 7pm Jazz), `date` picks out which real date's instance of that
// slot this booking is for. A student books/cancels per occurrence, not
// once-and-forever for the whole recurring series.
//
// Deliberately NOT unique on (studentId, sessionId, date) — a student who
// brings a friend along without getting them their own account books under
// their own studentId a second (or third...) time instead ("接龙两次"),
// each such row its own independent booking with its own credit deduction
// and its own cancel. See ALLOW_DUPLICATE handling in
// lib/actions/bookings.ts for the confirm-first gate on that, and the plain
// index below for the (studentId, sessionId, date) lookups that used to
// lean on the unique constraint (the duplicate-booking check itself,
// checkInByCode, ...).
model Booking {
  id          String         @id @default(cuid())
  student     Student        @relation(fields: [studentId], references: [id])
  studentId   String
  session     ClassSession   @relation(fields: [sessionId], references: [id])
  sessionId   String
  date        DateTime // the specific occurrence date, always normalized to midnight
  state       BookingState   @default(BOOKED)
  checkedIn   Boolean        @default(false)
  proxy       Boolean        @default(false)
  createdAt   DateTime       @default(now())
  ledgerEntry LedgerEntry?
  events      BookingEvent[]

  @@index([studentId, sessionId, date])
  @@map("bookings")
}

// Append-only audit trail of 接龙 activity for one class occurrence —
// distinct from Booking, which only holds *current* state and a single
// createdAt (overwritten in meaning once a booking is cancelled, and with
// no timestamp at all for *when* a cancel happened). 课时登记's roster
// dialog reads this to show admin a chronological add/cancel log —
// including cancelled bookings, which otherwise leave the roster with no
// visible trace of who was ever there. `bookingId` is kept for traceability
// but not required by the UI — Booking rows are never hard-deleted (see
// cancelOccurrenceBooking), so it always resolves.
model BookingEvent {
  id        String           @id @default(cuid())
  session   ClassSession     @relation(fields: [sessionId], references: [id])
  sessionId String
  date      DateTime // the occurrence date, same convention as Booking.date
  student   Student          @relation(fields: [studentId], references: [id])
  studentId String
  booking   Booking?         @relation(fields: [bookingId], references: [id])
  bookingId String?
  type      BookingEventType
  createdAt DateTime         @default(now())

  @@index([sessionId, date])
  @@map("booking_events")
}

model CardProduct {
  id           String        @id @default(cuid())
  type         CardType
  nameZh       String
  nameEn       String
  price        Int
  sessions     Int? // null when isUnlimited
  isUnlimited  Boolean       @default(false)
  validityDays Int
  studentCards StudentCard[]

  @@map("card_products")
}

model StudentCard {
  id            String        @id @default(cuid())
  student       Student       @relation(fields: [studentId], references: [id])
  studentId     String
  product       CardProduct?  @relation(fields: [productId], references: [id])
  productId     String?
  type          CardType
  nameZh        String
  nameEn        String
  balance       Int? // null when isUnlimited
  isUnlimited   Boolean       @default(false)
  total         Int?
  expiry        DateTime
  ledgerEntries LedgerEntry[]
  payments      Payment[]

  @@map("student_cards")
}

model LedgerEntry {
  id        String       @id @default(cuid())
  student   Student      @relation(fields: [studentId], references: [id])
  studentId String
  card      StudentCard? @relation(fields: [cardId], references: [id])
  cardId    String?
  booking   Booking?     @relation(fields: [bookingId], references: [id])
  bookingId String?      @unique
  kind      LedgerKind
  titleZh   String
  titleEn   String
  date      DateTime
  delta     Int // classes; negative = consumed
  noteZh    String?
  noteEn    String?

  @@map("ledger_entries")
}

// Money actually paid by a student (card purchase/top-up). Needed because
// LedgerEntry.delta only tracks class counts, not CNY — this is what backs
// adminKpis.revenue and the monthly cashFlow chart (group by month, sum amount).
model Payment {
  id        String        @id @default(cuid())
  student   Student       @relation(fields: [studentId], references: [id])
  studentId String
  card      StudentCard?  @relation(fields: [cardId], references: [id])
  cardId    String?
  amount    Int // CNY
  method    PaymentMethod @default(TRANSFER)
  paidAt    DateTime      @default(now())

  @@map("payments")
}

// A login account. Optionally linked 1:1 to the business record it acts as
// (Student/Teacher) — ADMIN accounts have neither. passwordHash format is
// "salt:hash" (scrypt, see lib/auth.ts) — not a bcrypt/argon2 string.
model User {
  id                 String    @id @default(cuid())
  username           String    @unique
  passwordHash       String
  role               UserRole
  mustChangePassword Boolean   @default(false)
  createdAt          DateTime  @default(now())
  student            Student?  @relation(fields: [studentId], references: [id])
  studentId          String?   @unique
  teacher            Teacher?  @relation(fields: [teacherId], references: [id])
  teacherId          String?   @unique
  sessions           Session[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("sessions")
}

enum BackupAction {
  BACKUP
  RESTORE
}

enum BackupStatus {
  SUCCESS
  FAILED
}

// Audit log for the admin 备份/还原 feature (lib/backup.ts) — never itself
// touched by a restore, so the log survives the operation it's recording.
model BackupRecord {
  id        String       @id @default(cuid())
  action    BackupAction
  filename  String
  status    BackupStatus
  message   String?
  createdBy String
  createdAt DateTime     @default(now())

  @@map("backup_records")
}
